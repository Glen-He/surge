# 数据库连接（PostgreSQL）
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/surge

# better-auth 认证密钥（ openssl rand -hex 32 生成）
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# SMTP 邮件发送（验证码 / 通知邮件用）
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# 首次部署的默认账号：启动时自动创建（已存在则跳过）；
# 留空则不创建默认用户。密码建议部署后尽快登录修改
SEED_USER_EMAIL=
SEED_USER_PASSWORD=
