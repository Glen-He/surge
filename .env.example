# SURGE 环境变量样例（与 src/infrastructure/environment/schema.ts 契约同步，
# 由 env-contract.test.ts 强制校验；本地复制为 .env.local 后填写）。
# 密钥生成：openssl rand -hex 32；所有 secret 至少 32 字符。

# ── 数据库 ──
# PostgreSQL 连接串
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/surge
# 业务/认证两个连接池的各自最大连接数（默认 10）
DB_POOL_MAX=10
# 业务查询 / 认证查询硬超时（毫秒，防登录界面无限等待）
DB_QUERY_TIMEOUT_MS=15000
AUTH_DB_QUERY_TIMEOUT_MS=15000

# ── 认证（better-auth）──
# 认证密钥，同时是 report capability 签名的派生根密钥（至少 32 字符）
BETTER_AUTH_SECRET=
# 应用对外 origin；生产必须 HTTPS（loopback 除外）
BETTER_AUTH_URL=http://localhost:3000
# 可选 OTP HMAC 专用密钥（至少 32 字符）；留空从 BETTER_AUTH_SECRET 派生
OTP_SECRET=
# 信任的反代地址（IP/CIDR，逗号分隔）：认证限流按真实客户端 IP 分桶用；
# 反代与应用同机保持默认，跨机部署填反代所在内网地址或网段
TRUSTED_PROXIES=127.0.0.1,::1

# ── 注册邀请 ──
# 邀请码 HMAC lookup 与 AES-GCM 加密的独立派生根密钥（至少 32 字符）。
# 邀请码存续期间不可丢失；注册策略由管理员页面即时管理
INVITE_CODE_SECRET=

# ── 分享 ──
# 分享密码门解锁凭证（unlock proof / cookie）签名密钥（至少 32 字符），
# 不与数据库口令共用，便于独立轮换
SHARE_SECRET=
# 分享 URL 令牌与 4 位提取码的 AES-GCM 加密根密钥（至少 32 字符）；
# 加密数据存续期间不可直接更换或丢失
SHARE_TOKEN_ENCRYPTION_KEY=

# ── API 令牌 ──
# PAT 令牌 AES-GCM 独立加密根密钥（至少 32 字符）；供所有者再次查看明文，
# 令牌存续期间不可丢失或直接更换
API_TOKEN_ENCRYPTION_KEY=

# ── 内部维护 ──
# 外部 cron 触发 /api/internal/maintenance 的 Bearer 密钥（至少 32 字符）
MAINTENANCE_SECRET=

# ── 报告存储与内容域 ──
# 用户报告持久化数据目录。所有环境必填；生产必须指向代码/镜像目录
# 之外的挂载卷，本地也应使用 checkout 之外的专用目录
REPORTS_DATA_DIR=
# 独立、无 Cookie 的汇报内容域；本地可留空回退到 BETTER_AUTH_URL，生产必填
REPORTS_ORIGIN=
# 构建期注入的应用 origin 兜底（BETTER_AUTH_URL 的次级回退）
NEXT_PUBLIC_APP_URL=

# ── 上传 / 磁盘 / 保留策略 ──
# 跨实例最多同时解析 2 个上传；除本次写入外，磁盘至少保留 512 MiB；
# 崩溃遗留文件 60 分钟后回收；无法判断的回收区数据最多保留 168 小时
UPLOAD_MAX_CONCURRENCY=2
STORAGE_MIN_FREE_BYTES=536870912
STORAGE_ORPHAN_GRACE_MINUTES=60
STORAGE_RECOVERY_RETENTION_HOURS=168
# 安全审计日志保留天数；账号物理删除时该账号的日志会立即删除
SECURITY_LOG_RETENTION_DAYS=90

# ── SMTP（验证码 / 通知邮件）──
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# ── 日志 ──
# 结构化日志输出级别：debug | info | warn | error（默认生产 info、开发 debug）
LOG_LEVEL=
# 日志中邮箱/IP 的不可逆指纹盐（至少 32 字符）；留空从 BETTER_AUTH_SECRET 派生
LOG_REDACTION_SECRET=
