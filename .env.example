# 数据库连接（PostgreSQL）
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/surge

# 用户报告的持久化数据目录。生产必须指向代码/镜像目录之外的挂载卷；
# 本地留空时兼容使用 reports/users。
REPORTS_DATA_DIR=

# 分享密码门的解锁凭证签名密钥（openssl rand -hex 32 生成）。
# 生产环境必填，不与数据库口令共用，便于独立轮换。
SHARE_SECRET=

# 业务/认证两个连接池的各自最大连接数（默认 10）
DB_POOL_MAX=10

# 结构化日志输出级别：debug | info | warn | error（默认生产 info、开发 debug）
LOG_LEVEL=

# better-auth 认证密钥（ openssl rand -hex 32 生成）
BETTER_AUTH_SECRET=
# 可选的 OTP HMAC 专用密钥；留空时从 BETTER_AUTH_SECRET 派生使用
OTP_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# 独立、无 Cookie 的汇报内容域；本地可留空回退到 BETTER_AUTH_URL，生产必填。
REPORTS_ORIGIN=

# 信任的反代地址（IP/CIDR，逗号分隔）：认证限流按真实客户端 IP 分桶用。
# 反代与应用同机保持默认即可；跨机部署填反代所在内网地址或网段
TRUSTED_PROXIES=127.0.0.1,::1

# SMTP 邮件发送（验证码 / 通知邮件用）
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
