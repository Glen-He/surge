# 数据库连接（PostgreSQL）
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/surge

# 用户报告的持久化数据目录。所有环境必填；生产必须指向代码/镜像目录
# 之外的挂载卷，本地也应使用 checkout 之外的专用目录。
REPORTS_DATA_DIR=

# 上传与存储保护：跨实例最多同时解析 2 个上传；除本次写入外，磁盘至少
# 保留 512 MiB。崩溃遗留文件 60 分钟后回收；无法判断的回收区数据最多
# 保留 168 小时，避免永久占盘。
UPLOAD_MAX_CONCURRENCY=2
STORAGE_MIN_FREE_BYTES=536870912
STORAGE_ORPHAN_GRACE_MINUTES=60
STORAGE_RECOVERY_RETENTION_HOURS=168

# 安全审计日志保留天数；账号物理删除时该账号的日志会立即删除。
SECURITY_LOG_RETENTION_DAYS=90

# 邀请码 HMAC 与 AES-GCM 独立派生密钥的根密钥（openssl rand -hex 32
# 生成）。邀请码存续期间不可丢失；注册策略由管理员页面即时管理。
INVITE_CODE_SECRET=

# API 令牌的 AES-GCM 独立加密根密钥（openssl rand -hex 32 生成）。
# 用于让令牌所有者再次查看明文；令牌存续期间不可丢失或直接更换。
API_TOKEN_ENCRYPTION_KEY=

# 外部 cron 触发完整清理任务时使用的 Bearer 密钥（openssl rand -hex 32）。
MAINTENANCE_SECRET=

# 分享密码门的解锁凭证签名密钥（openssl rand -hex 32 生成）。
# 所有环境必填且至少 32 字符，不与数据库口令共用，便于独立轮换。
SHARE_SECRET=
# 分享 URL 令牌和 4 位提取码的 AES-GCM 加密根密钥（必填，至少 32 字符）。
# 加密数据存续期间不可直接更换或丢失。
SHARE_TOKEN_ENCRYPTION_KEY=

# 业务/认证两个连接池的各自最大连接数（默认 10）
DB_POOL_MAX=10
# 业务查询与认证查询的硬超时（毫秒），防止登录界面无限等待
DB_QUERY_TIMEOUT_MS=15000
AUTH_DB_QUERY_TIMEOUT_MS=15000

# 结构化日志输出级别：debug | info | warn | error（默认生产 info、开发 debug）
LOG_LEVEL=
# 日志中邮箱/IP 的不可逆指纹盐；设置时至少 32 字符，留空则从 BETTER_AUTH_SECRET 派生。
LOG_REDACTION_SECRET=

# better-auth 认证密钥（openssl rand -hex 32 生成）
BETTER_AUTH_SECRET=
# 可选的 OTP HMAC 专用密钥；设置时至少 32 字符，留空则从 BETTER_AUTH_SECRET 派生
OTP_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# 独立、无 Cookie 的汇报内容域；本地可留空回退到 BETTER_AUTH_URL，生产必填。
REPORTS_ORIGIN=

# 信任的反代地址（IP/CIDR，逗号分隔）：认证限流按真实客户端 IP 分桶用。
# 反代与应用同机保持默认即可；跨机部署填反代所在内网地址或网段
TRUSTED_PROXIES=127.0.0.1,::1

# SMTP 邮件发送（验证码 / 通知邮件用）
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
