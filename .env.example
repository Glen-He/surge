# 数据库连接（PostgreSQL）
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/surge

# 分享密码门的解锁凭证签名密钥（openssl rand -hex 32 生成）。
# 未配置时回退用 DATABASE_URL 派生（内含高熵口令）；两者皆缺时生产环境拒绝启动
SHARE_SECRET=

# 业务/认证两个连接池的各自最大连接数（默认 10）
DB_POOL_MAX=10

# 结构化日志输出级别：debug | info | warn | error（默认生产 info、开发 debug）
LOG_LEVEL=

# better-auth 认证密钥（ openssl rand -hex 32 生成）
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# 信任的反代地址（IP/CIDR，逗号分隔）：认证限流按真实客户端 IP 分桶用。
# 反代与应用同机保持默认即可；跨机部署填反代所在内网地址或网段
TRUSTED_PROXIES=127.0.0.1,::1

# SMTP 邮件发送（验证码 / 通知邮件用）
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# 首次部署的默认账号：启动时自动创建（已存在则跳过）；
# 留空则不创建默认用户。密码建议部署后尽快登录修改
SEED_USER_EMAIL=
SEED_USER_PASSWORD=
