# CI ONLY — 测试假环境，值无任何生产价值，可公开提交（DO NOT USE IN PRODUCTION）。
# 新增环境变量须先在 src/infrastructure/environment/schema.ts 注册；
# 本文件与 schema 的同步由 env-contract.test.ts 在 CI environment job
# 1 秒内强制校验（ciRequiredEnvKeys 全覆盖 + 格式合法）。
# 真正的生产密钥只存在于部署服务器的 /opt/surge/.env，绝不进入 Git。

DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/surge_test
BETTER_AUTH_SECRET=ci-only-better-auth-secret-at-least-32-characters
BETTER_AUTH_URL=http://127.0.0.1:3000
INVITE_CODE_SECRET=ci-only-invite-code-secret-at-least-32-characters
SHARE_SECRET=ci-only-share-secret-at-least-32-characters
SHARE_TOKEN_ENCRYPTION_KEY=ci-only-share-token-encryption-key-at-least-32-characters
API_TOKEN_ENCRYPTION_KEY=ci-only-api-token-encryption-key-at-least-32-characters
MAINTENANCE_SECRET=ci-only-maintenance-secret-at-least-32-characters
REPORTS_DATA_DIR=/tmp/surge-report-data
SMTP_HOST=localhost
SMTP_PORT=465
SMTP_USER=ci@example.test
SMTP_PASS=ci-only-password
